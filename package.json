{
  "name": "control-tower",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot index.ts",
    "start": "bun --hot index.ts",
    "start:prod": "NODE_ENV=production bun index.ts",
    "restart": "systemctl --user restart control-tower.service && sleep 2 && curl -fsS http://localhost:${PORT:-4317}/api/health",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "tsc --noEmit && bun test && bun scripts/check-docs.ts",
    "check:docs": "bun scripts/check-docs.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@pug-frame/canvas": "^0.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
